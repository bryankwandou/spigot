# Copy to .env.local for development. In production these live in Vercel's
# environment settings and nowhere else. Nothing in this file belongs in git.

# Neon Postgres. The probe log and the community reports live here.
DATABASE_URL=

# Shared secret between the scheduled workflow and /api/relay/tick.
# Any long random string. Also set it as the RELAY_TOKEN repository secret.
RELAY_TOKEN=

# Optional. Defaults to the public devnet endpoint, which is rate limited.
SOLANA_RPC_URL=

# The devnet pool. The address is public; the secret is not.
SPIGOT_TREASURY_ADDRESS=
# 64 bytes as a JSON array, the shape solana-keygen writes.
#
# This is the only way a key enters the app. Nothing reads a wallet file from
# disk, because a path inside the repository ends up deployed and public. Set
# this in Vercel's environment settings and in .env.local, which git ignores.
#
# Either shape works: the base58 string a wallet like Solflare or Phantom gives
# you when you export, or the 64-byte JSON array the Solana CLI writes. Paste it
# as-is; converting between the two by hand is how keys end up in shell history.
#
# Use a keypair that has never held mainnet funds. If this value is ever pasted
# into a chat, an issue, or a screenshot, treat it as gone and generate another.
SPIGOT_TREASURY_SECRET=
