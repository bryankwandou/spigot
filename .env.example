# Copy to .env.local for development. In production these live in Vercel's
# environment settings and nowhere else. Nothing in this file belongs in git.

# Neon Postgres. The probe log and the community reports live here. Without it
# the board still renders — every faucet simply reads as unknown.
DATABASE_URL=

# Shared secret between the scheduled workflow and /api/relay/tick.
# Any long random string. Also set it as the RELAY_TOKEN repository secret.
RELAY_TOKEN=

# Optional. Defaults to the public devnet endpoint, which is rate limited.
SOLANA_RPC_URL=

# There is no wallet here on purpose. Spigot holds no funds and signs nothing:
# collected airdrops are sent straight to the treasury address below.
# Nothing in this deployment needs a private key, so nothing is given one.

# Public key that collected airdrops are sent to. Optional; the default is the
# project treasury. Crediting an account takes no signature, so the collector
# half of this service needs nothing secret at all.
TREASURY_ADDRESS=

# Devnet-only signing key for the dispenser, as a JSON array of bytes. Leave it
# empty and the dispenser simply stays closed; everything else keeps working.
#
# Only ever put a key here that was generated for this service, on devnet, from
# a zero balance. Never a wallet that also holds mainnet funds, and never one
# whose seed phrase covers other chains - a secret in a serverless environment
# ends up in build logs, error reports and every future deploy.
TREASURY_SECRET=

# Set this in Vercel, not here. Vercel's own scheduler sends it as a bearer
# token on the daily call to /api/relay/tick.
CRON_SECRET=
