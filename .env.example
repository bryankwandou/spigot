# Copy to .env.local for development. In production these live in Vercel's
# environment settings and nowhere else. Nothing in this file belongs in git.

# Neon Postgres. The attempt log and the cooldown clock live here.
DATABASE_URL=

# The devnet treasury. The address is public; the secret is not.
SPIGOT_TREASURY_ADDRESS=
# 64 bytes as a JSON array, the shape solana-keygen writes.
# Generate a fresh keypair for this. Do not reuse a wallet that has ever held
# mainnet funds, and do not paste this value into a chat window.
SPIGOT_TREASURY_SECRET=

# Shared secret between the scheduled workflow and /api/relay/tick.
# Any long random string. Also set it as the RELAY_TOKEN repository secret.
RELAY_TOKEN=

# Optional. Defaults to the public devnet endpoint, which is rate limited.
SOLANA_RPC_URL=
